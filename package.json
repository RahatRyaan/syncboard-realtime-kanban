{
  "name": "syncboard",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time SaaS Kanban and document collaboration platform",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "dev:api": "pnpm --filter @syncboard/api run dev",
    "dev:web": "pnpm --filter @syncboard/web run dev",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run lint",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run test",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.4.1"
}
